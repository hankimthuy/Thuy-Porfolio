# Production URL for SEO metadata (canonical, Open Graph, sitemap, JSON-LD)
# Set this in Vercel Environment Variables for Production:
#   NEXT_PUBLIC_SITE_URL=https://hankimthuy.com
NEXT_PUBLIC_SITE_URL=https://hankimthuy.com

# --- Umami analytics --------------------------------------------------------
# Tracking only renders when BOTH are set, so local dev and preview deploys
# never pollute production stats. Website ID comes from the Umami dashboard.
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id

# Optional: Google Search Console site verification token
# 1. Add property https://hankimthuy.com in Search Console
# 2. Choose "HTML tag" verification → copy the content value only
# 3. Set GOOGLE_SITE_VERIFICATION in Vercel, redeploy
# 4. Submit sitemap: https://hankimthuy.com/sitemap.xml
# 5. URL Inspection → Request indexing for https://hankimthuy.com/
# GOOGLE_SITE_VERIFICATION=your-verification-code

# Optional: set LOCALE_SWITCHER_ENABLED=true in lib/i18n-config.ts
# (or uncomment <LanguageSwitcher /> in Header.tsx) after Vietnamese copy is reviewed

# --- Off-page SEO (manual, after deploy) ---
# LinkedIn: headline "Han Kim Thuy (Hàn Kim Thủy) · Product Engineer"; Featured → hankimthuy.com
# GitHub (hankimthuy): bio with full name + portfolio URL
# CV / email signature / Zalo: link to https://hankimthuy.com with varied anchor text

# Production URL for SEO metadata (canonical, Open Graph, sitemap, JSON-LD)
# Set this in Vercel Environment Variables for Production:
#   NEXT_PUBLIC_SITE_URL=https://thuyhankim.id.vn
NEXT_PUBLIC_SITE_URL=https://thuyhankim.id.vn

# Optional: Google Search Console site verification token
# 1. Add property https://thuyhankim.id.vn in Search Console
# 2. Choose "HTML tag" verification → copy the content value only
# 3. Set GOOGLE_SITE_VERIFICATION in Vercel, redeploy
# 4. Submit sitemap: https://thuyhankim.id.vn/sitemap.xml
# 5. URL Inspection → Request indexing for https://thuyhankim.id.vn/
# GOOGLE_SITE_VERIFICATION=your-verification-code

# Optional: set LOCALE_SWITCHER_ENABLED=true in lib/i18n-config.ts
# (or uncomment <LanguageSwitcher /> in Header.tsx) after Vietnamese copy is reviewed

# --- Off-page SEO (manual, after deploy) ---
# LinkedIn: headline "Han Kim Thuy (Hàn Kim Thủy) · Product Engineer"; Featured → thuyhankim.id.vn
# GitHub (hankimthuy): bio with full name + portfolio URL
# CV / email signature / Zalo: link to https://thuyhankim.id.vn with varied anchor text
